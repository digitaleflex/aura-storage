flowchart TB
    %% AURA Storage — architecture cible initiale (single-node MVP)

    classDef client fill:#102A56,stroke:#38BDF8,color:#F8FAFC,stroke-width:2px
    classDef edge fill:#312E81,stroke:#A78BFA,color:#FFFFFF,stroke-width:2px
    classDef api fill:#082F49,stroke:#22D3EE,color:#FFFFFF,stroke-width:2px
    classDef storage fill:#064E3B,stroke:#34D399,color:#FFFFFF,stroke-width:2px
    classDef ops fill:#3B0764,stroke:#C084FC,color:#FFFFFF,stroke-width:2px
    classDef backup fill:#713F12,stroke:#FACC15,color:#FFFFFF,stroke-width:2px
    classDef warning fill:#450A0A,stroke:#F87171,color:#FFFFFF,stroke-width:2px
    classDef future fill:#431407,stroke:#FB923C,color:#FFFFFF,stroke-width:2px

    subgraph CLIENTS["Clients et applications"]
        ADMIN["Administrateur<br/>SSH / outils S3"]
        APPS["Applications clientes<br/>OpenBooks · autres services"]
        USERS["Utilisateurs autorisés"]
    end

    subgraph AURA["AURA-001 · VPS de stockage"]
        direction TB
        HOST["Ubuntu Server LTS<br/>Docker Engine + Compose"]
        EDGE["Reverse proxy HTTPS<br/>TLS · port public 443"]
        S3["SeaweedFS Filer + API S3<br/>port interne 8333"]
        VOL["SeaweedFS Volume / données<br/>ports internes uniquement"]
        DISK[("Volume persistant hôte<br/>données et métadonnées")]
        HOST --> EDGE
        EDGE --> S3
        S3 --> VOL
        VOL --> DISK
    end

    subgraph OPERATIONS["Sécurité et exploitation"]
        SSH["SSH par clés<br/>accès restreint"]
        MON["Surveillance<br/>santé · disque · trafic · journaux"]
        SECRETS["Secrets locaux<br/>identifiants S3 par application"]
    end

    subgraph RECOVERY["Protection des données"]
        BACKUP[("Sauvegarde indépendante<br/>autre VPS / fournisseur / NAS")]
        RESTORE["Test de restauration<br/>intégrité vérifiée"]
    end

    subgraph FUTURE["Évolution ultérieure"]
        AURA2["AURA-002<br/>capacité supplémentaire"]
        AURA3["AURA-003<br/>réplication / autre rôle"]
        AXIOM["Axiom<br/>supervision via API, plus tard"]
    end

    ADMIN -->|"SSH sécurisé"| SSH
    ADMIN -->|"Import / récupération S3"| EDGE
    APPS -->|"HTTPS + API S3<br/>credentials limités / URL signée"| EDGE
    USERS -->|"Accès autorisé via application"| APPS
    SECRETS -. "authentification" .-> S3
    MON -. "contrôles locaux" .-> HOST
    DISK -->|"Sauvegardes planifiées"| BACKUP
    BACKUP --> RESTORE
    AURA -->|"API de gestion limitée, ultérieure"| AXIOM
    AURA -. "extension future" .-> AURA2
    AURA2 -. "extension future" .-> AURA3

    class ADMIN,APPS,USERS client
    class EDGE edge
    class S3 api
    class HOST,VOL,DISK storage
    class SSH,MON,SECRETS ops
    class BACKUP,RESTORE backup
    class AURA2,AURA3,AXIOM future
