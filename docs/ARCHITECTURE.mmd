flowchart TB
    %% AURA Storage — architecture cible initiale

    classDef client fill:#102A56,stroke:#38BDF8,color:#F8FAFC,stroke-width:2px
    classDef edge fill:#312E81,stroke:#A78BFA,color:#FFFFFF,stroke-width:2px
    classDef api fill:#082F49,stroke:#22D3EE,color:#FFFFFF,stroke-width:2px
    classDef storage fill:#064E3B,stroke:#34D399,color:#FFFFFF,stroke-width:2px
    classDef ops fill:#3B0764,stroke:#C084FC,color:#FFFFFF,stroke-width:2px
    classDef backup fill:#713F12,stroke:#FACC15,color:#FFFFFF,stroke-width:2px
    classDef future fill:#431407,stroke:#FB923C,color:#FFFFFF,stroke-width:2px

    subgraph CLIENTS["Clients et applications"]
        ADMIN["Administrateur<br/>SSH / client S3"]
        APPS["Applications<br/>OpenBooks · autres services"]
        USERS["Utilisateurs autorisés"]
    end

    subgraph AURA["AURA-001 · VPS de stockage"]
        direction TB
        HOST["Ubuntu Server LTS<br/>Docker Engine + Compose"]
        TRAEFIK["Traefik Proxy<br/>HTTPS · certificats Let's Encrypt<br/>Dashboard protégé"]
        S3["SeaweedFS Filer + API S3<br/>port interne 8333"]
        DATA[("Volumes persistants<br/>fichiers + métadonnées")]
        HOST --> TRAEFIK
        TRAEFIK -->|"Route HTTPS vers le réseau Docker privé"| S3
        S3 --> DATA
    end

    subgraph MANAGEMENT["API et exploitation AURA"]
        API["AURA Management API<br/>inventaire · dossiers virtuels<br/>recherche · métadonnées"]
        AUTH["Authentification et autorisation<br/>audit · quotas · permissions"]
        MON["Surveillance<br/>état · capacité · trafic · journaux"]
        SSH["SSH par clés<br/>accès restreint"]
    end

    subgraph RECOVERY["Protection des données"]
        BACKUP[("Sauvegarde indépendante<br/>autre VPS / fournisseur / NAS")]
        RESTORE["Test de restauration<br/>intégrité vérifiée"]
    end

    subgraph FUTURE["Intégrations futures"]
        AXIOM["Axiom<br/>supervision via API"]
        OPENBOOKS["OpenBooks<br/>catalogue et droits d'accès"]
        AURA2["AURA-002<br/>extension future"]
    end

    ADMIN -->|"SSH sécurisé"| SSH
    ADMIN -->|"Import / récupération"| TRAEFIK
    APPS -->|"HTTPS + API S3<br/>identifiants dédiés / URL signées"| TRAEFIK
    USERS -->|"Via les applications"| APPS
    API -->|"Accès contrôlé aux métadonnées"| DATA
    API -. "authentification / autorisation" .-> AUTH
    MON -. "métriques et journaux" .-> HOST
    DATA -->|"Sauvegarde planifiée"| BACKUP
    BACKUP --> RESTORE
    AXIOM <-->|"API versionnée, plus tard"| API
    OPENBOOKS <-->|"S3 + métadonnées selon intégration"| API
    AURA -. "extension future" .-> AURA2

    class ADMIN,APPS,USERS client
    class TRAEFIK edge
    class S3 api
    class HOST,DATA storage
    class API,AUTH,MON,SSH ops
    class BACKUP,RESTORE backup
    class AXIOM,OPENBOOKS,AURA2 future
