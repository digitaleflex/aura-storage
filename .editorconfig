# https://editorconfig.org — mêmes réglages de base pour tous les éditeurs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.sh]
indent_size = 2

[*.md]
# Deux espaces en fin de ligne = saut de ligne forcé en Markdown.
trim_trailing_whitespace = false
