# Local deployment secrets and generated configuration
.env
.env.*
!.env.example
/config/seaweedfs/s3*.json
!/config/seaweedfs/s3*.json.example
*.pem
*.key
*.p12
*.pfx
*.cer
*.jks
secrets/
credentials/
certs/
private/

# TLS material: acme.json stores private keys; never commit it.
acme.json
letsencrypt/

# SSH keys (defence in depth; keys normally live in ~/.ssh).
id_rsa*
id_ed25519*

# Storage data and backups
data/
volumes/
backups/
*.backup
*.dump
*.tar.gz
*.sql
# User-uploaded files must never be committed.
userfiles/

# Editors / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
node_modules/
.venv/
__pycache__/
.pytest_cache/
.envrc
aura-audit.jsonl
*.db
*.db-wal
*.db-shm
*.db-journal

# Local build backups (never commit)
web/dist.bak-*/
