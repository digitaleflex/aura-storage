# Off-site backup destination for scripts/backup.sh, restore-check.sh, restore.sh.
# Copy to config/backup.env (git-ignored), chmod 600, fill in. Values are read
# literally (no shell expansion). See docs/BACKUP-RESTORE.md.

# Pinned rclone image used to run every transfer.
RCLONE_IMAGE=rclone/rclone:1.68.2

# The off-site backend: ANY rclone backend, declared as remote "offsite" through
# RCLONE_CONFIG_OFFSITE_* variables. It must be another provider/account than
# the VPS. Example: an S3-compatible bucket (Backblaze B2, Scaleway, Wasabi...).
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Other
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.REPLACE_REGION.example.com
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=REPLACE_WITH_BACKUP_ACCESS_KEY
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=REPLACE_WITH_BACKUP_SECRET_KEY

# Bucket/path on that backend. Everything below it is encrypted client-side.
BACKUP_REMOTE=offsite:REPLACE_WITH_BUCKET/aura

# rclone crypt keys, in `rclone obscure` form:
#   docker run --rm rclone/rclone:1.68.2 obscure "$(openssl rand -base64 32)"
# Keep the CLEAR passwords offline with the SSE key. Without them the backup
# cannot be read; changing them later orphans every existing backup.
BACKUP_CRYPT_PASSWORD=REPLACE_WITH_OBSCURED_PASSWORD
BACKUP_CRYPT_PASSWORD2=REPLACE_WITH_OBSCURED_SALT

# Snapshots and displaced object versions older than this are pruned.
BACKUP_RETENTION_DAYS=30
# Parallel object transfers.
BACKUP_TRANSFERS=4

# Optional dead-man switch (e.g. https://hc-ping.com/<uuid>): /start, /fail and
# success pings. Alert on "no success ping in 26h".
# BACKUP_MONITOR_URL=
