{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "subagent_depth": 2,
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "config/backup.env": "deny",
      "**/config/backup.env": "deny",
      "config/seaweedfs/s3.json": "deny",
      "**/config/seaweedfs/s3.json": "deny",
      ".env.example": "allow",
      "**/.env.example": "allow",
      "config/backup.env.example": "allow",
      "**/config/backup.env.example": "allow"
    },
    "edit": "allow",
    "bash": {
      "*": "allow",
      "sudo": "deny",
      "sudo *": "deny",
      "doas *": "deny",
      "su *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "sftp *": "deny",
      "rsync *": "deny",
      "telnet *": "deny",
      "nc *": "deny",
      "ncat *": "deny",
      "socat *": "deny",
      "git push origin main": "deny",
      "git push * main": "deny",
      "docker compose up": "deny",
      "docker compose up *": "deny",
      "docker compose down": "deny",
      "docker compose down *": "deny",
      "docker compose rm *": "deny",
      "docker compose kill *": "deny",
      "docker volume rm *": "deny",
      "docker system prune*": "deny",
      "docker volume prune*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "docker compose restart": "deny",
      "docker compose restart *": "deny",
      "docker compose pull": "deny",
      "docker compose pull *": "deny",
      "docker stop *": "deny",
      "docker restart *": "deny",
      "docker rm *": "deny",
      "docker volume *": "deny",
      "docker exec*": "deny",
      "docker compose exec*": "deny",
      "docker inspect*": "deny",
      "docker compose config*": "deny",
      "docker logs*": "deny",
      "docker compose logs*": "deny",
      "docker cp*": "deny",
      "systemctl *": "deny",
      "service *": "deny",
      "apt *": "deny",
      "apt-get *": "deny",
      "dpkg *": "deny",
      "ufw *": "deny",
      "iptables *": "deny",
      "ip6tables *": "deny",
      "nft *": "deny",
      "reboot": "deny",
      "shutdown*": "deny",
      "mount *": "deny",
      "umount *": "deny",
      "chown *": "deny",
      "chmod *": "deny",
      "rm -rf*": "deny",
      "find * -delete": "deny",
      "truncate *": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "useradd *": "deny",
      "usermod *": "deny",
      "visudo*": "deny",
      "passwd *": "deny",
      "crontab *": "deny"
    },
    "external_directory": "ask",
    "doom_loop": "ask"
  }
}
