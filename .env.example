# AURA identity
AURA_INSTANCE_ID=aura-001
TZ=Africa/Porto-Novo

# Review and pin a tested release before deployment; never use latest in production.
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:3.80

# Bind the S3 endpoint to loopback only; expose it via a reviewed HTTPS proxy.
S3_BIND_ADDRESS=127.0.0.1
S3_HOST_PORT=8333

# Placeholders only: replace with cryptographically generated values.
S3_ACCESS_KEY=replace-with-generated-access-key
S3_SECRET_KEY=replace-with-generated-long-random-secret

# Persistent host path
AURA_DATA_DIR=./data

# Public endpoint reference only; no credentials in URLs.
S3_PUBLIC_ENDPOINT=https://storage.example.invalid
