# AURA identity
AURA_INSTANCE_ID=aura-001
TZ=Africa/Porto-Novo

# Pin reviewed versions before production. Confirm release notes and image availability.
TRAEFIK_IMAGE=traefik:v3.4.3
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:3.80

# Public DNS must point to this VPS before ACME HTTP challenge can succeed.
S3_DOMAIN=storage.example.com
ACME_EMAIL=admin@example.com

# Storage root: ensure this path is on the intended large disk/filesystem.
AURA_DATA_DIR=./data
SEAWEED_VOLUME_SIZE_LIMIT_MB=30000
SEAWEED_VOLUME_MAX=0

# Generate these values securely; placeholders must be replaced.
# Keep credentials consistent with config/seaweedfs/s3.json (local, ignored by Git).
S3_ACCESS_KEY=replace-with-generated-access-key
S3_SECRET_KEY=replace-with-generated-long-random-secret
