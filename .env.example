# AURA identity
AURA_INSTANCE_ID=aura-001
TZ=Africa/Porto-Novo

# Container images: review release notes before changing production versions.
TRAEFIK_IMAGE=traefik:v3.4.3
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.48

# Public endpoint. DNS must point to this VPS before the first deployment.
# Pilot hostname: aura-storage.eurinhash.com (verified resolving to the VPS).
S3_DOMAIN=aura-storage.eurinhash.com
ACME_EMAIL=admin@eurinhash.com

# Absolute path recommended for production, on the intended storage filesystem.
# Example: /srv/aura-storage
AURA_DATA_DIR=/srv/aura-storage
SEAWEED_VOLUME_SIZE_LIMIT_MB=30000
SEAWEED_VOLUME_MAX=0

# Generate a unique 20+ character alphanumeric access key and a long random secret.
# The config generator injects these into the local s3.json. Never commit .env.
S3_ACCESS_KEY=REPLACE_WITH_GENERATED_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_GENERATED_LONG_RANDOM_SECRET

# Required 256-bit (32-byte) hex key for SeaweedFS SSE-S3 at-rest object encryption.
# Generate locally with: openssl rand -hex 32
# Keep a protected offline copy: losing this key may make encrypted objects unrecoverable.
WEED_S3_SSE_KEK=REPLACE_WITH_64_HEX_CHARACTERS
