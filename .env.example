# AURA identity
AURA_INSTANCE_ID=aura-001
TZ=Africa/Porto-Novo

# Container images: review release notes before changing production versions.
TRAEFIK_IMAGE=traefik:v3.4.3
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:3.80

# Public endpoint. DNS must point to this VPS before the first deployment.
# During initial launch, use the subdomain you control, e.g. s3.aura.eurinhash.com.
S3_DOMAIN=s3.aura.eurinhash.com
ACME_EMAIL=admin@eurinhash.com

# Absolute path recommended for production, on the intended storage filesystem.
# Example: /srv/aura-storage
AURA_DATA_DIR=/srv/aura-storage
SEAWEED_VOLUME_SIZE_LIMIT_MB=30000
SEAWEED_VOLUME_MAX=0

# Generate strong unique values. The config generator injects these into s3.json.
# Do not commit .env or share its contents.
S3_ACCESS_KEY=REPLACE_WITH_GENERATED_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_GENERATED_LONG_RANDOM_SECRET
